<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AstroColour.Desktop"
        xmlns:controls="using:AstroColour.Desktop.Controls"
        x:Class="AstroColour.Desktop.MainWindow"
        Title="Astro Colour Editor"
        Icon="/Assets/AppIcon.ico"
        Width="1500" Height="950" MinWidth="700" MinHeight="450"
        Background="{DynamicResource ChromeBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeBrush" Color="#FFEEEEEE" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#1F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeBrush" Color="#FF1C1C1C" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FF262626" />
                    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="controls|LineIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Rectangle.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,8" />
            <Setter Property="Fill" Value="{DynamicResource PanelStrokeBrush}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.strong">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabControl#EditorTabs > TabItem">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="UniformGrid#CurveChannels > ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,5" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <StackPanel x:Name="Toolbar" Grid.Row="0" Orientation="Horizontal" Margin="6,4" Spacing="2">
            <Button x:Name="OpenButton" Classes="tool" Click="Open_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LineIcon Data="M1.5,3.5 H6 L7.5,5.5 H14.5 V12.5 H1.5 Z" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveButton" Classes="tool" Click="Save_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LineIcon Data="M2.5,2.5 H11 L13.5,5 V13.5 H2.5 Z M5,2.5 V5.5 H10 V2.5 M4.5,13.5 V9 H11.5 V13.5" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveAsButton" Classes="tool" Click="SaveAs_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LineIcon Data="M8,1.5 V9.5 M4.5,6 L8,9.5 L11.5,6 M2.5,10 V13.5 H13.5 V10" />
                    <TextBlock Text="Save as" />
                </StackPanel>
            </Button>
            <Rectangle Classes="separator" />
            <Button x:Name="RotateLeftButton" Classes="tool" Click="RotateLeft_Click">
                <controls:LineIcon Data="M2,8 A6,6 0 1 0 8,2 C6.32,2 4.71,2.67 3.51,3.83 L2,5.33 M2,2 V5.33 H5.33" />
            </Button>
            <Button x:Name="RotateRightButton" Classes="tool" Click="RotateRight_Click">
                <controls:LineIcon Data="M14,8 A6,6 0 1 1 8,2 C9.68,2 11.29,2.67 12.49,3.83 L14,5.33 M14,2 V5.33 H10.67" />
            </Button>
            <Rectangle Classes="separator" />
            <Button x:Name="FitButton" Classes="tool" Click="Fit_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LineIcon Data="M1.5,5.5 V1.5 H5.5 M10.5,1.5 H14.5 V5.5 M14.5,10.5 V14.5 H10.5 M5.5,14.5 H1.5 V10.5" />
                    <TextBlock Text="Fit" />
                </StackPanel>
            </Button>
            <Button x:Name="ActualSizeButton" Classes="tool" Click="ActualSize_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LineIcon Data="M1.5,6.5 A5,5 0 1 1 11.5,6.5 A5,5 0 1 1 1.5,6.5 Z M10.2,10.2 L14.5,14.5" />
                    <TextBlock Text="100%" />
                </StackPanel>
            </Button>
            <Rectangle Classes="separator" />
            <ToggleButton x:Name="CompareButton" Classes="tool" Click="Compare_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:LineIcon Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M8,1 V15" />
                    <TextBlock Text="Before" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,340">

            <!-- Image -->
            <Panel Grid.Column="0" Background="#FF141414" ClipToBounds="True">
                <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              SizeChanged="Viewer_SizeChanged">
                    <Panel x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                           PointerPressed="ImageHost_PointerPressed"
                           PointerMoved="ImageHost_PointerMoved"
                           PointerReleased="ImageHost_PointerReleased"
                           PointerCaptureLost="ImageHost_PointerCaptureLost"
                           PointerExited="ImageHost_PointerExited"
                           PointerWheelChanged="ImageHost_PointerWheelChanged"
                           PointerTouchPadGestureMagnify="ImageHost_Magnify">
                        <!-- Rotation is shown here and only applied to the pixels on saving. -->
                        <LayoutTransformControl x:Name="ImageRotator">
                            <Image x:Name="PreviewImage" Stretch="Fill" />
                        </LayoutTransformControl>
                    </Panel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <controls:LineIcon Data="M4.5,8.5 H43.5 V39.5 H4.5 Z M4.5,33 L16,22 L26,31 L32,26 L43.5,36 M30,16 A3,3 0 1 1 36,16 A3,3 0 1 1 30,16 Z"
                          Width="48" Height="48" Foreground="#FF707070" StrokeThickness="2" HorizontalAlignment="Center" />
                    <TextBlock Text="Open an XISF, FITS or TIFF image to begin" Foreground="#FFB0B0B0" HorizontalAlignment="Center" />
                    <Button Content="Open image…" HorizontalAlignment="Center" Classes="accent" Click="Open_Click" />
                </StackPanel>

                <StackPanel VerticalAlignment="Top" Margin="12" Spacing="8">
                    <controls:InfoBar x:Name="LinearInfo" Severity="Warning" Title="This image looks linear (unstretched)"
                                      Message="Colour editing works best on a stretched, non-linear image. Stretch it in PixInsight first for reliable colour selection." />
                    <controls:InfoBar x:Name="MessageInfo" />
                </StackPanel>

                <Panel x:Name="BusyOverlay" Background="#80000000" IsVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressBar IsIndeterminate="True" Width="160" />
                        <TextBlock x:Name="BusyText" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Panel>

            <!-- Editor panel -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1,0,0,0">
                <TabControl x:Name="EditorTabs" Padding="0" Margin="4,4,0,0" SelectionChanged="EditorTabs_SelectionChanged">
                    <TabItem x:Name="ColourTab" Header="Colour">
                        <ScrollViewer x:Name="ColourPanel" VerticalScrollBarVisibility="Auto" IsEnabled="False">
                            <StackPanel Margin="12,8,16,16" Spacing="12">
                                <ToggleButton x:Name="PickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                              Click="Picker_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:LineIcon Data="M8,1 V4.5 M8,11.5 V15 M1,8 H4.5 M11.5,8 H15 M3.5,8 A4.5,4.5 0 1 1 12.5,8 A4.5,4.5 0 1 1 3.5,8 Z" />
                                        <TextBlock Text="Pick colour from image" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock x:Name="PickerHint" TextWrapping="Wrap" Classes="caption secondary"
                                           Text="Turn on the picker, then click a colour in the image to add it to the list. Drag to pan, scroll to zoom." />

                                <ListBox x:Name="AdjustmentList" SelectionMode="Single" MaxHeight="240" Background="Transparent"
                                         SelectionChanged="AdjustmentList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:AdjustmentItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                                        Background="{Binding Swatch}"
                                                        BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Summary}" Classes="caption secondary" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsActive}"
                                                          ToolTip.Tip="Enable or disable this adjustment" />
                                                <Button Grid.Column="3" Padding="6" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                        Tag="{Binding}" Click="DeleteAdjustment_Click" ToolTip.Tip="Remove">
                                                    <controls:LineIcon Width="14" Height="14"
                                                          Data="M2,3.5 H12 M5,3.5 V1.5 H9 V3.5 M3.5,3.5 L4.2,12.5 H9.8 L10.5,3.5" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="EditorPanel" Spacing="0" IsVisible="False">
                                    <Grid Margin="0,4,0,4">
                                        <TextBlock Text="Adjust" Classes="strong" VerticalAlignment="Center" />
                                        <HyperlinkButton Content="Reset" HorizontalAlignment="Right" Padding="4,2" Click="ResetAdjustment_Click"
                                                         ToolTip.Tip="Reset hue, saturation and lightness" />
                                    </Grid>
                                    <controls:LabeledSlider x:Name="HueShiftSlider" Label="Hue" Minimum="-90" Maximum="90" Unit="°" ShowSign="True"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="SaturationSlider" Label="Saturation" Minimum="-100" Maximum="100" ShowSign="True"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="LightnessSlider" Label="Lightness" Minimum="-100" Maximum="100" ShowSign="True"
                                                            ValueChanged="EditorSlider_ValueChanged" />

                                    <TextBlock Text="Selected range" Classes="strong" Margin="0,12,0,4" />
                                    <ToggleSwitch x:Name="ShowMaskToggle" Content="View selected colour range" OffContent="Off" OnContent="On"
                                                  IsCheckedChanged="ShowMaskToggle_Toggled" Margin="0,0,0,4" />
                                    <controls:LabeledSlider x:Name="TargetHueSlider" Label="Centre hue" Minimum="0" Maximum="359" Unit="°"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="RangeSlider" Label="Range" Minimum="1" Maximum="90" DefaultValue="20" Unit="°"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="SmoothnessSlider" Label="Smoothness" Minimum="0" Maximum="90" DefaultValue="25" Unit="°"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="LightnessMinSlider" Label="Darkest" Minimum="0" Maximum="100" DefaultValue="0" Unit="%"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="LightnessMaxSlider" Label="Brightest" Minimum="0" Maximum="100" DefaultValue="100" Unit="%"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="LightnessSmoothnessSlider" Label="Lightness smoothness" Minimum="0" Maximum="50" DefaultValue="10" Unit="%"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                    <controls:LabeledSlider x:Name="ProtectSlider" Label="Protect neutrals" Minimum="0" Maximum="90" DefaultValue="5" Unit="%"
                                                            ValueChanged="EditorSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="CurvesTab" Header="Curves">
                        <ScrollViewer x:Name="CurvesPanel" VerticalScrollBarVisibility="Auto" IsEnabled="False">
                            <StackPanel Margin="12,8,16,16" Spacing="12">
                                <UniformGrid x:Name="CurveChannels" Rows="1" ColumnSpacing="4">
                                    <ToggleButton x:Name="CurveRgbButton" Content="RGB" IsChecked="True" Click="CurveChannel_Click"
                                                  ToolTip.Tip="Curve applied to all channels" />
                                    <ToggleButton x:Name="CurveRedButton" Content="Red" Click="CurveChannel_Click" />
                                    <ToggleButton x:Name="CurveGreenButton" Content="Green" Click="CurveChannel_Click" />
                                    <ToggleButton x:Name="CurveBlueButton" Content="Blue" Click="CurveChannel_Click" />
                                </UniformGrid>

                                <controls:CurveEditor x:Name="CurveGraph" CurveChanged="CurveGraph_CurveChanged" />

                                <Grid>
                                    <TextBlock x:Name="CurveChannelText" Classes="strong" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <HyperlinkButton Content="Reset" Padding="4,2" Click="ResetCurve_Click"
                                                         ToolTip.Tip="Reset this channel's curve" />
                                        <HyperlinkButton Content="Reset all" Padding="4,2" Click="ResetAllCurves_Click"
                                                         ToolTip.Tip="Reset the curves of every channel" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Classes="caption secondary"
                                           Text="Click the graph to add a point and drag to move it. Double-click or right-click a point, or drag it off the graph, to remove it. Moving the end points sets the black and white points. Curves are applied after the colour editor." />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Margin="12,4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24">
            <TextBlock x:Name="FileInfoText" Classes="caption" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PixelInfoText" Grid.Column="1" Classes="caption" FontFamily="Consolas, Menlo, monospace" />
            <TextBlock x:Name="ZoomText" Grid.Column="2" Classes="caption" />
        </Grid>
    </Grid>
</Window>
