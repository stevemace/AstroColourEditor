<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AstroColour.App.Controls.LabeledSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid ToolTipService.ToolTip="Double-click to reset" DoubleTapped="Label_DoubleTapped" Background="Transparent">
            <TextBlock x:Name="LabelText" />
            <TextBlock x:Name="ValueText" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Slider x:Name="Slider" StepFrequency="1" IsThumbToolTipEnabled="False" ValueChanged="Slider_ValueChanged" />
        <Rectangle x:Name="Gradient" Height="5" RadiusX="2.5" RadiusY="2.5" Margin="10,-8,10,6"
                   Visibility="Collapsed" IsHitTestVisible="False" />
    </StackPanel>
</UserControl>
