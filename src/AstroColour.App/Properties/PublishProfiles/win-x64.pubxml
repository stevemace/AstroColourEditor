<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained build that runs on any Windows 10 (1809+) / 11 x64 PC with nothing installed.
     dotnet publish src/AstroColour.App -p:PublishProfile=win-x64
     Output: publish/win-x64 at the repo root. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
    <!-- English-only .NET satellite assemblies. (The xx-XX folders are Windows App SDK .mui files and are still copied.) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
